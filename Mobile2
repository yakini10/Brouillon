<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FFF0F5">

    <TextView
        android:id="@+id/textViewContact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Контактные данные"
        android:textColor="#000000"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp" />

    <TextView
        android:id="@+id/textViewName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Нет данных"
        android:textColor="#000000"
        android:textSize="22sp"
        android:layout_marginBottom="30dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/buttonPrevious"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:contentDescription="Предыдущий контакт"
            android:src="@android:drawable/ic_media_previous"
            android:backgroundTint="#D8BFD8" />

        <ImageButton
            android:id="@+id/buttonNext"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_marginStart="40dp"
            android:contentDescription="Следующий контакт"
            android:src="@android:drawable/ic_media_next"
            android:backgroundTint="#D8BFD8" />

    </LinearLayout>

    <Button
        android:id="@+id/buttonAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Добавить"
        android:textSize="18sp"
        android:backgroundTint="#4CAF50" />

    <Button
        android:id="@+id/buttonEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Изменить"
        android:textSize="18sp"
        android:backgroundTint="#FF9800" />

</LinearLayout>



import android.content.Intent
import android.os.Bundle
import android.widget.Button
import android.widget.ImageButton
import android.widget.TextView
import androidx.appcompat.app.AppCompatActivity
import androidx.activity.viewModels

class MainActivity : AppCompatActivity() {

    private val viewModel: ContactViewModel by viewModels()

    private lateinit var textViewName: TextView
    private lateinit var buttonPrevious: ImageButton
    private lateinit var buttonNext: ImageButton
    private lateinit var buttonAdd: Button
    private lateinit var buttonEdit: Button

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        textViewName = findViewById(R.id.textViewName)
        buttonPrevious = findViewById(R.id.buttonPrevious)
        buttonNext = findViewById(R.id.buttonNext)
        buttonAdd = findViewById(R.id.buttonAdd)
        buttonEdit = findViewById(R.id.buttonEdit)

        updateContact()

        buttonPrevious.setOnClickListener {
            viewModel.previousContact()
            updateContact()
        }

        buttonNext.setOnClickListener {
            viewModel.nextContact()
            updateContact()
        }

        buttonAdd.setOnClickListener {
            val intent = Intent(this, EditActivity::class.java)
            intent.putExtra("mode", "add")
            startActivity(intent)
        }

        buttonEdit.setOnClickListener {
            if (viewModel.hasContacts()) {
                val intent = Intent(this, EditActivity::class.java)
                intent.putExtra("mode", "edit")
                startActivity(intent)
            }
        }
    }

    override fun onResume() {
        super.onResume()
        if (::textViewName.isInitialized) {
            updateContact()
        }
    }

    private fun updateContact() {
        val contact = viewModel.getCurrentContact()

        if (contact == null) {
            textViewName.text = "Нет данных"
        } else {
            textViewName.text =
                "${contact.surname} ${contact.name} ${contact.patronymic}\n${contact.phone}"
        }
    }
}


import androidx.lifecycle.ViewModel

class ContactViewModel : ViewModel() {

    private val contacts = mutableListOf<Contact>()

    private var currentIndex = 0

    fun getCurrentContact(): Contact? {
        return if (contacts.isEmpty()) {
            null
        } else {
            contacts[currentIndex]
        }
    }

    fun hasContacts(): Boolean {
        return contacts.isNotEmpty()
    }

    fun addContact(contact: Contact) {
        contacts.add(contact)
        currentIndex = contacts.lastIndex
    }

    fun editContact(contact: Contact) {
        if (contacts.isNotEmpty()) {
            contacts[currentIndex] = contact
        }
    }

    fun previousContact() {
        if (contacts.isNotEmpty()) {
            currentIndex =
                (currentIndex - 1 + contacts.size) % contacts.size
        }
    }

    fun nextContact() {
        if (contacts.isNotEmpty()) {
            currentIndex = (currentIndex + 1) % contacts.size
        }
    }
}
